10 PRINT CHR$(147)
20 PRINT "GRAPHICS MODE TEST"
30 PRINT "=================="
40 PRINT "SWITCHING TO BITMAP MODE..."
50 REM CLEAR BITMAP AREA
60 FOR I=8192 TO 16191:POKE I,0:NEXT
70 REM SET BITMAP MODE
80 POKE 53265,PEEK(53265) OR 32
90 POKE 53272,PEEK(53272) OR 8
100 REM DRAW DIAGONAL LINE
110 FOR X=0 TO 199
120 BY=8192+INT(X/8)*320+INT(X/8)*8+(X AND 7)
130 BT=128/(2^(X AND 7))
140 POKE BY,PEEK(BY) OR BT
150 NEXT X
160 REM WAIT FOR KEYPRESS
170 GET A$:IF A$="" THEN 170
180 REM RESTORE TEXT MODE
190 POKE 53265,PEEK(53265) AND 223
200 PRINT CHR$(147)
210 PRINT "GRAPHICS TEST COMPLETE."
