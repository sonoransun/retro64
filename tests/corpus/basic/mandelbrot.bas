10 PRINT CHR$(147)
20 PRINT "MANDELBROT SET"
30 FOR Y=0 TO 20
40 FOR X=0 TO 39
50 CR=-2.0+X*3.0/39.0
60 CI=-1.1+Y*2.2/20.0
70 ZR=0:ZI=0
80 FOR I=0 TO 15
90 TR=ZR*ZR-ZI*ZI+CR
100 ZI=2*ZR*ZI+CI
110 ZR=TR
120 IF ZR*ZR+ZI*ZI>4 THEN 140
130 NEXT I
140 IF I>15 THEN PRINT "*";:GOTO 160
150 PRINT " ";
160 NEXT X
170 PRINT
180 NEXT Y
190 PRINT "DONE."
