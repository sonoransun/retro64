10 PRINT CHR$(147)
20 PRINT "BUBBLE SORT TEST"
30 PRINT "================"
40 N=10
50 DIM A(10)
60 REM FILL WITH RANDOM VALUES
70 FOR I=1 TO N
80 A(I)=INT(RND(1)*100)
90 NEXT I
100 PRINT "BEFORE: ";
110 FOR I=1 TO N:PRINT A(I);:NEXT I
120 PRINT
130 REM BUBBLE SORT
140 FOR I=1 TO N-1
150 FOR J=1 TO N-I
160 IF A(J)>A(J+1) THEN T=A(J):A(J)=A(J+1):A(J+1)=T
170 NEXT J
180 NEXT I
190 PRINT "AFTER:  ";
200 FOR I=1 TO N:PRINT A(I);:NEXT I
210 PRINT
220 PRINT "DONE."
